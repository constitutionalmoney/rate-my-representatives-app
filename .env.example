# Local foundation configuration. No production endpoints or credentials belong here.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

PASSKEY_AUTH_ENABLED=false
VERIFIED_EMAIL_AUTH_ENABLED=false
ACCOUNT_RECOVERY_ENABLED=false
ACCOUNT_DATA_ACCESS_ENABLED=false
ACCOUNT_EXPORT_ENABLED=false
ACCOUNT_CORRECTION_ENABLED=false
ACCOUNT_DELETION_ENABLED=false
LOCATION_RESOLUTION_ENABLED=false
PRIVILEGED_ACCESS_ENABLED=false
NATIVE_PARTICIPATION_ENABLED=false
CIVIC_SIGNAL_ENABLED=false
REPRESENTATIVE_SIGNALS_ENABLED=false
CATEGORY_RATINGS_ENABLED=false
COMMUNITY_CONTEXT_ENABLED=false
EVIDENCE_SUBMISSION_ENABLED=false
SOURCE_INGESTION_ENABLED=false
AI_RESEARCH_ENABLED=false
VERUS_ID_LINKING_ENABLED=false
VERUS_AUTH_ENABLED=false
REPRESENTATIVE_CLAIMS_ENABLED=false
REPRESENTATIVE_VERUS_CLAIMS_ENABLED=false
VERUS_IDENTITY_UPDATE_ENABLED=false
CBC_ATTESTATION_ENABLED=false
PROVENANCE_WRITES_ENABLED=false
VERUS_ANCHORING_ENABLED=false
COMPOSITE_SCORE_ENABLED=false

# Synthetic local-infrastructure addresses and identifiers. `pnpm infra:prepare`
# generates untracked random secret files beneath .local/infra/secrets.
RMR_POSTGRES_PORT=5432
RMR_RABBITMQ_PORT=5672
RMR_RABBITMQ_MANAGEMENT_PORT=15672
RMR_OBJECT_STORAGE_PORT=9000
RMR_OBJECT_STORAGE_CONSOLE_PORT=9001
RMR_MAILPIT_SMTP_PORT=1025
RMR_MAILPIT_UI_PORT=8025
RMR_API_PORT=3000
VERUS_NETWORK=VRSCTEST
VERUS_DAEMON_VERSION=v1.2.16-1
