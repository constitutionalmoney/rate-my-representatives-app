{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": false,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "strict": true
  },
  "include": [
    "App.tsx",
    "app.config.ts",
    "index.ts",
    "mobile-environments.ts",
    "mobile-environments.json",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
