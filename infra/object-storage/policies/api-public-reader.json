{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::rmr-public"],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["approved-manifests", "approved-manifests/*"]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::rmr-public/approved-manifests/*"]
    }
  ]
}
