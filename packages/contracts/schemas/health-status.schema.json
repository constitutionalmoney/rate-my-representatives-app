{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ratemyrepresentatives.example/foundation/health-status.schema.json",
  "title": "HealthStatus",
  "description": "Synthetic foundation health response. This is not a production status claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "service", "version", "optionalDependencies"],
  "properties": {
    "status": {
      "const": "ready"
    },
    "service": {
      "const": "api"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "optionalDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verus"],
      "properties": {
        "verus": {
          "enum": ["disabled", "degraded", "ready"]
        }
      }
    }
  }
}
